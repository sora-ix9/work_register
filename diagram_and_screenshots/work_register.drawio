          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="227.51000000000002" y="751" as="sourcePoint" />
            <mxPoint x="677.51" y="751" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jdOuLizi3ej9enKsTDyy-18" value="&lt;ul&gt;&lt;li&gt;Client sends raw image in binary format.&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; The aforesaid sending is called &lt;b&gt;raw_img event&lt;/b&gt;.&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;Server sends face-detected image and time in binary format. The aforesaid sending is called &lt;b&gt;detected_img event&lt;/b&gt;.&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;Client sends&amp;nbsp;face-detected image and time.&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; The aforesaid sending is called &lt;b&gt;confirm_yes event&lt;/b&gt;.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="247.5" y="647" width="410" height="30" as="geometry" />
        </mxCell>
        <mxCell id="MnGuOT-vDvHyL4JgTysU-2" value="WebSocket closing handshake" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="260.16" y="781" width="379.69" height="30" as="geometry" />
        </mxCell>
        <mxCell id="MnGuOT-vDvHyL4JgTysU-4" value="" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeWidth=3;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="227.5" y="811" as="sourcePoint" />
            <mxPoint x="677.5" y="811" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MnGuOT-vDvHyL4JgTysU-6" value="&lt;ul&gt;&lt;li&gt;When &lt;b&gt;raw_img event &lt;/b&gt;is spotted, the following steps is performed:&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. Call the function &lt;b&gt;binImg_to_arrImg(bin_img)&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/b&gt;2. Call the function &lt;b&gt;detect_face(img)&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/b&gt;3. Send face-detected image and time, i.e. &lt;b&gt;detected_img event&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;When &lt;b&gt;confirm_yes event&lt;/b&gt;&lt;b&gt; &lt;/b&gt;is spotted, the face-detected image and time being received are registered to database.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="720" y="647" width="510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="MnGuOT-vDvHyL4JgTysU-7" value="&lt;ul&gt;&lt;li&gt;When &lt;b&gt;detected_img event &lt;/b&gt;is spotted, client would&amp;nbsp; display face-detected image.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="-210" y="590" width="389.83" height="30" as="geometry" />
        </mxCell>
